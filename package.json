{
  "name": "redline",
  "version": "0.11.0",
  "desktopName": "redline",
  "private": true,
  "repository": "github:timlcode/redline",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "node server.mjs",
    "electron": "electron .",
    "test": "node --test test/pdf.test.mjs test/ocr.test.mjs test/edit.test.mjs test/pages.test.mjs test/comments.test.mjs test/shapes.test.mjs test/measure.test.mjs test/send.test.mjs test/password.test.mjs test/render.test.mjs test/forms.test.mjs test/output.test.mjs test/signature.test.mjs test/redact.test.mjs test/view.test.mjs test/tabs.test.mjs",
    "bench": "node scripts/bench.mjs",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "mupdf": "1.28.1",
    "onnxruntime-node": "^1.30.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "io.github.timlcode.redline",
    "productName": "Redline",
    "asar": false,
    "afterPack": "scripts/after-pack.mjs",
    "files": [
      "server.mjs",
      "lib/**",
      "public/**",
      "models/**",
      "electron/**",
      "assets/**",
      "scripts/**",
      "package.json",
      "!test/**",
      "!bin/**",
      "!dist/**"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "assets/redline-512.png",
      "artifactName": "Redline-${version}-${arch}.${ext}",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/redline-512.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/redline-256.png"
    },
    "publish": {
      "provider": "github",
      "owner": "timlcode",
      "repo": "redline",
      "releaseType": "release"
    }
  }
}
